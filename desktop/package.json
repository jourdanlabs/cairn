{
  "name": "cairn-studio",
  "version": "1.0.0",
  "private": true,
  "description": "CAIRN — grounded, local knowledge-integrity, as a desktop studio.",
  "author": "JourdanLabs <leland@jourdanlabs.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --config.directories.output=dist"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jourdanlabs.cairn",
    "productName": "CAIRN Studio",
    "files": ["main.js"],
    "mac": {
      "identity": null,
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": "arm64" }]
    }
  }
}
