# CAIRN configuration.

# REQUIRED — the folder to index. Point it at your Obsidian vault…
# ~ is expanded to your home directory.
VAULT_DIR=~/Documents/MyVault
# …or point it at a whole project tree to find work you forgot you made:
#   VAULT_DIR=~/projects
# It skips node_modules/.git/dist/etc automatically.

# Which file types to index (comma-separated). Default is Markdown; add .txt to
# sweep a project tree for READMEs, notes, and docs.
INDEX_EXT=.md,.markdown

# Auto-reindex when files change (on/off). Edits show up live.
WATCH=on

# Optional — compliance: comma-separated TOP-LEVEL folders whose notes are treated
# as "controlled" (authoritative / governing documents), e.g. policies,standards.
# A note is ALSO controlled if its frontmatter has `authority: controlled`,
# `controlled: true`, or `status: controlled`. Answers grounded on a non-controlled
# source get flagged, and a contradiction between two controlled notes is escalated
# to HIGH severity in the Integrity Report.
CONTROLLED_DIRS=

# Optional — the exact vault name for obsidian:// deep links (so "Open in Obsidian"
# works). Defaults to the vault folder's name.
OBSIDIAN_VAULT_NAME=

# Optional — an OpenAI-compatible /chat/completions endpoint to enable AI "Ask"
# answers (grounded + cited). WITHOUT this, CAIRN still works fully: it returns
# ranked passages from your notes with zero network. Your vault never leaves the
# machine either way; only the retrieved snippets + your question are sent, and
# only when you use Ask mode with a key set.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini

# Web server port.
PORT=4600
